# Copy this file to `.env` and replace the placeholders with your secrets.

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Set LLM_PROVIDER to one of: openai, anthropic, azure, google, openrouter, custom
# Default: openai
LLM_PROVIDER=openai

# Set to "0" to disable LLM usage (uses dummy model for testing)
USE_WORKFLOW_LLM=1

# Temperature setting (0.0 to 2.0, default: 0)
LLM_TEMPERATURE=0

# ============================================================================
# OpenAI Configuration
# ============================================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional: Custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Anthropic (Claude) Configuration
# ============================================================================
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# Azure OpenAI Configuration
# ============================================================================
# AZURE_OPENAI_API_KEY=your-azure-api-key
# AZURE_OPENAI_API_BASE=https://your-resource.openai.azure.com
# AZURE_OPENAI_MODEL=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================================================
# Google (Gemini) Configuration
# ============================================================================
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_MODEL=gemini-pro

# ============================================================================
# OpenRouter Configuration
# ============================================================================
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ============================================================================
# Custom Provider Configuration
# ============================================================================
# CUSTOM_API_KEY=your-custom-api-key
# CUSTOM_MODEL=your-model-name
# CUSTOM_API_BASE=https://your-api-endpoint.com
# CUSTOM_API_TYPE=openai  # or anthropic, etc.
