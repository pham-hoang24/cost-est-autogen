# GPT-Lab’s Sandbox Environment Configuration
# Copy this file to .env.production and update the values

# ===========================================
# BASIC CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=8080

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# For SQLite (development)
DATABASE_URL=sqlite:./sw4e_database.db

# For PostgreSQL (production)
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# For MySQL (production)
# DATABASE_URL=mysql://username:password@hostname:3306/database_name

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Generate a secure JWT secret (32+ characters)
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Default admin password (change in production)
ADMIN_DEFAULT_PASSWORD=admin123

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000,http://localhost:3001

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# CLOUD STORAGE CONFIGURATION (Optional)
# ===========================================
# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2
S3_BUCKET=sw4e-uploads

# Google Cloud Storage
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCS_BUCKET=sw4e-uploads

# Azure Blob Storage
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_KEY=your-storage-key
# AZURE_CONTAINER=sw4e-uploads

# ===========================================
# MONITORING & LOGGING (Optional)
# ===========================================
# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Prometheus metrics
PROMETHEUS_ENDPOINT=http://prometheus:9090

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# ===========================================
# RATE LIMITING
# ===========================================
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ===========================================
# DATA RETENTION
# ===========================================
DATA_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# ===========================================
# FEATURE FLAGS
# ===========================================
ANONYMIZATION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ROLE_EXTENSION_ENABLED=true

# ===========================================
# CLOUD PROVIDER SPECIFIC
# ===========================================

# AWS
# AWS_REGION=us-west-2
# AWS_AVAILABILITY_ZONE=us-west-2a

# Google Cloud
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_REGION=us-central1

# Azure
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_RESOURCE_GROUP=sw4e-sandbox
# AZURE_LOCATION=eastus

# DigitalOcean
# DO_REGION=nyc1
# DO_SIZE=s-2vcpu-2gb

# ===========================================
# SSL/TLS CONFIGURATION
# ===========================================
# SSL certificate paths (for custom certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===========================================
# DEVELOPMENT/DEBUG (Set to false in production)
# ===========================================
DEBUG=false
VERBOSE_LOGGING=false
